# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- DeepSeek (copy the exact model ID from your DeepSeek dashboard) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DAILY_LIMIT_PER_USER=200

# --- Job sources (all optional; the demo source works with no keys) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
DEMO_SOURCE=true

# --- Applying ---
# dry_run prepares applications but sends nothing. Use live only after testing.
APPLY_MODE=dry_run
RESEND_API_KEY=
MAIL_FROM=
DEFAULT_MIN_MATCH=75
DEFAULT_DAILY_LIMIT=10

# --- Scheduler ---
# Random long string; the GitHub Action sends it to /api/cron/scan
CRON_SECRET=
SCAN_INTERVAL_MIN=15
# Adzuna and Reed run less often to respect their limits
API_SOURCES_MIN_INTERVAL_MIN=60

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Access ---
# invite = beta (invite-only, verified email). open = public sign-up.
SIGNUP_MODE=invite
